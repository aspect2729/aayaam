# Local demo only. Never use this password outside a development database.
AAYAAM_DEMO_PASSWORD=aayaam-local-demo
# Set to 1 only if a production process should load the demo workspace.
AAYAAM_SEED_DEMO=

# Server-only. Leave blank until the provider account exists.
# A blank value keeps the integration in pending_configuration. The app does not call the provider.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=
EMAIL_WEBHOOK_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Feature flags. Server only. Set a flag to 1 only after its keys exist.
# A missing flag keeps the integration in Awaiting setup. The app does not call the provider.
FEATURE_WHATSAPP=
FEATURE_EMAIL=
FEATURE_GBP_API=
FEATURE_GBP_BROWSER_ASSIST=
FEATURE_SHOPIFY=
FEATURE_WOOCOMMERCE=
FEATURE_RAZORPAY=
FEATURE_SHIPROCKET=
FEATURE_SEARCH_CONSOLE=
FEATURE_CONNECTOR_SHEETS=
FEATURE_CONNECTOR_NOTION=
FEATURE_CONNECTOR_ZOHO=
FEATURE_CONNECTOR_ODOO=
FEATURE_AI=
# AI gateway. Server only. Leave blank until the provider account exists.
# Prices were read on 31 Oct 2026 from the official pricing pages. A blank key does not call a model.
# Google: https://ai.google.dev/gemini-api/docs/pricing
# OpenAI: https://developers.openai.com/api/docs/pricing
AI_PRIMARY_PROVIDER=google
AI_FALLBACK_PROVIDER=openai
AI_MODEL_FAST_GOOGLE=gemini-3.5-flash-lite
AI_MODEL_STANDARD_GOOGLE=gemini-3.8-flash
AI_MODEL_FAST_OPENAI=gpt-6-luna
AI_MODEL_STANDARD_OPENAI=gpt-5.4-mini
AI_MODEL_ESCALATION_OPENAI=gpt-6.1-sol
AI_MODEL_EMBED_GOOGLE=gemini-embedding-001
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MONTHLY_BUDGET_INR_DEFAULT=500
# Required before the INR budget can be enforced. Do not guess a rate in code.
AI_USD_INR_RATE=
AI_GLOBAL_DAILY_BUDGET_USD=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Local SEO. Server only. A blank value does not call the provider.
# Places: https://developers.google.com/maps/documentation/places/web-service/text-search
# PageSpeed: https://developers.google.com/speed/docs/insights/v5/get-started
# CrUX: https://developer.chrome.com/docs/crux/api
# Business Profile access: https://developers.google.com/my-business/content/prereqs
# Search Console: https://developers.google.com/webmaster-tools/v1/api_reference_index
# Maps rank data, if you choose DataForSEO: https://docs.dataforseo.com/v3/serp/google/maps/live/advanced/
# Do not scrape Google Search or Maps. Do not use the Indexing API for ordinary pages.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_MAPS_API_KEY=
GOOGLE_PSI_API_KEY=
GOOGLE_CRUX_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
LOCAL_FALCON_API_KEY=
SERPAPI_API_KEY=
BROWSER_PROVIDER=
BROWSER_WORKER_URL=
BROWSER_WORKER_SECRET=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
INDEXNOW_KEY=
BING_WEBMASTER_API_KEY=
PERPLEXITY_API_KEY=
FEATURE_PLACES=
FEATURE_PSI=
FEATURE_CRUX=
FEATURE_KEYWORDS=
FEATURE_RANK=
FEATURE_BROWSER=
FEATURE_BROWSER_SUPERVISED_WRITE=
FEATURE_WORDPRESS=
FEATURE_INDEXNOW=

# Optional connector secrets. Server only.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
SENTRY_DSN=
POSTHOG_KEY=

# Optional production Postgres. The local app uses data/aayaam.sqlite and does not read this.
DATABASE_URL=

# Supabase project for Aayaam. Server only. Do not use the anon key here.
# Run db/supabase/001_activity.sql in the Supabase SQL editor, then restart the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
